      "api_key_env": [
        "CEREBRAS2_API_KEY"
      ],
      "models": [
        "gpt-oss-120b",
        "zai-glm-4.7"
      ],
      "thinking_models": [],
      "max_tokens_param": "max_completion_tokens",
      "reasoning_effort": {
        "gpt-oss-120b": "low",
        "zai-glm-4.7": "none"
      }
